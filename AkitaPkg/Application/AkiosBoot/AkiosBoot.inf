## @file
#  AkiosBoot.efi: what U-Boot starts on akita. It finds the boot payload U-Boot placed in memory, publishes its
#  ESP image as a read-only disk, starts the FAT driver the payload carries, keeps the log in the phone's logdump
#  partition, and runs UniXNU's boot manager on that ESP.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION    = 0x00010019
  BASE_NAME      = AkiosBoot
  FILE_GUID      = 4A2E91C7-6F35-4B08-8D1A-C93B7E52F064
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 0.1
  ENTRY_POINT    = AkiosBootEntry

[Sources]
  AkiosBoot.c
  AkiosBoot.h
  Payload.c
  PayloadDisk.c
  LogDump.c

[Packages]
  MdePkg/MdePkg.dec
  UniXNUPkg/UniXNUPkg.dec
  AkitaPkg/AkitaPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  PrintLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
  UefiRuntimeServicesTableLib
  UniXNULib

[Protocols]
  gEfiBlockIoProtocolGuid          ## PRODUCES ## CONSUMES
  gEfiDevicePathProtocolGuid       ## PRODUCES
  gEfiDiskIoProtocolGuid           ## PRODUCES
  gEfiPartitionInfoProtocolGuid    ## CONSUMES

[Guids]
  gAkitaPayloadDiskGuid
